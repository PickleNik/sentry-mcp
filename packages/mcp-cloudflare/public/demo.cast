[231.060652, "o", "\r\n\u001b[2m\u001b[38;5;244m╭──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m > \u001b[7m \u001b[27m                                                                                                                      \u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[39m\u001b[22m\r\n  \u001b[38;5;147m⏵⏵ accept edits on\u001b[38;5;246m\u001b[2m (shift+tab to cycle)\u001b[22m\u001b[39m                                             \u001b[38;5;211m2 MCP servers failed\u001b[39m \u001b[2m· /mcp for info\u001b[22m\r\n"]
[235.834776, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\r\n\u001b[2m\u001b[38;5;244m╭──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m > \u001b[7m \u001b[27m                                                                                                                      \u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[39m\u001b[22m\r\n  \u001b[38;5;147m⏵⏵ accept edits on\u001b[38;5;246m\u001b[2m (shift+tab to cycle)\u001b[22m\u001b[39m\r\n"]
[235.878486, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\r\n\u001b[2m\u001b[38;5;244m╭──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m > /\u001b[7m \u001b[27m                                                                                                                     \u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[39m\u001b[22m\r\n  \u001b[38;5;153m/gh-pr\u001b[39m              \u001b[38;5;153mCreate (or update) a Pull Request. (project)\u001b[39m\r\n  \u001b[2m/gh-review\u001b[22m          \u001b[2mAddress feedback and checks in a Pull Request. (project)\u001b[22m\r\n  \u001b[2m/add-dir\u001b[22m            \u001b[2mAdd a new working directory\u001b[22m\r\n  \u001b[2m/agents\u001b[22m             \u001b[2mManage agent configurations\u001b[22m\r\n  \u001b[2m/bashes\u001b[22m             \u001b[2mList and manage background bash shells\u001b[22m\r\n  \u001b[2m/bug\u001b[22m                \u001b[2mSubmit feedback about Claude Code\u001b[22m\r\n  \u001b[2m/clear (reset)\u001b[22m      \u001b[2mClear conversation history and free up context\u001b[22m\r\n  \u001b[2m/compact\u001b[22m            \u001b[2mClear conversation history but keep a summary in context. Optional: /compact [instructions for \u001b[22m\r\n                      \u001b[2msummarization]\u001b[22m\r\n  \u001b[2m/config (theme)\u001b[22m     \u001b[2mOpen config panel\u001b[22m\r\n  \u001b[2m/context\u001b[22m            \u001b[2mVisualize current context usage as a colored grid\u001b[22m\r\n"]
[236.038457, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\r\n\u001b[2m\u001b[38;5;244m╭──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m > /c\u001b[7m \u001b[27m                                                                                                                    \u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[39m\u001b[22m\r\n  \u001b[38;5;153m/gh-pr\u001b[39m              \u001b[38;5;153mCreate (or update) a Pull Request. (project)\u001b[39m\r\n  \u001b[2m/gh-review\u001b[22m          \u001b[2mAddress feedback and checks in a Pull Request. (project)\u001b[22m\r\n  \u001b[2m/add-dir\u001b[22m            \u001b[2mAdd a new working directory\u001b[22m\r\n  \u001b[2m/agents\u001b[22m             \u001b[2mManage agent configurations\u001b[22m\r\n  \u001b[2m/bashes\u001b[22m             \u001b[2mList and manage background bash shells\u001b[22m\r\n  \u001b[2m/bug\u001b[22m                \u001b[2mSubmit feedback about Claude Code\u001b[22m\r\n  \u001b[2m/clear (reset)\u001b[22m      \u001b[2mClear conversation history and free up context\u001b[22m\r\n  \u001b[2m/compact\u001b[22m            \u001b[2mClear conversation history but keep a summary in context. Optional: /compact [instructions for \u001b[22m\r\n                      \u001b[2msummarization]\u001b[22m\r\n  \u001b[2m/config (theme)\u001b[22m     \u001b[2mOpen config panel\u001b[22m\r\n  \u001b[2m/context\u001b[22m            \u001b[2mVisualize current context usage as a colored grid\u001b[22m\r\n"]
[236.076149, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\r\n\u001b[2m\u001b[38;5;244m╭──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m > /c\u001b[7m \u001b[27m                                                                                                                    \u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[39m\u001b[22m\r\n  \u001b[38;5;153m/clear (reset)\u001b[39m                        \u001b[38;5;153mClear conversation history and free up context\u001b[39m\r\n  \u001b[2m/compact\u001b[22m                              \u001b[2mClear conversation history but keep a summary in context. Optional: /compact \u001b[22m\r\n                                        \u001b[2m[instructions for summarization]\u001b[22m\r\n  \u001b[2m/config (theme)\u001b[22m                       \u001b[2mOpen config panel\u001b[22m\r\n  \u001b[2m/context\u001b[22m                              \u001b[2mVisualize current context usage as a colored grid\u001b[22m\r\n  \u001b[2m/cost\u001b[22m                                 \u001b[2mShow the total cost and duration of the current session\u001b[22m\r\n  \u001b[2m/pr-comments\u001b[22m                          \u001b[2mGet comments from a GitHub pull request\u001b[22m\r\n  \u001b[2m/mcp\u001b[22m                                  \u001b[2mManage MCP servers\u001b[22m\r\n  \u001b[2m/doctor\u001b[22m                               \u001b[2mDiagnose and verify your Claude Code installation and settings\u001b[22m\r\n  \u001b[2m/security-review\u001b[22m                      \u001b[2mComplete a security review of the pending changes on the current branch\u001b[22m\r\n  \u001b[2m/sentry:find_errors_in_file (MCP)\u001b[22m     \u001b[2mUse this prompt when you need to find errors in Sentry for a given file. \u001b[22m\r\n                                        \u001b[2m(arguments: organizationSlug, filename)\u001b[22m\r\n"]
[236.138749, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\r\n\u001b[2m\u001b[38;5;244m╭──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m > /cl\u001b[7m \u001b[27m                                                                                                                   \u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[39m\u001b[22m\r\n  \u001b[38;5;153m/clear (reset)\u001b[39m                        \u001b[38;5;153mClear conversation history and free up context\u001b[39m\r\n  \u001b[2m/compact\u001b[22m                              \u001b[2mClear conversation history but keep a summary in context. Optional: /compact \u001b[22m\r\n                                        \u001b[2m[instructions for summarization]\u001b[22m\r\n  \u001b[2m/config (theme)\u001b[22m                       \u001b[2mOpen config panel\u001b[22m\r\n  \u001b[2m/context\u001b[22m                              \u001b[2mVisualize current context usage as a colored grid\u001b[22m\r\n  \u001b[2m/cost\u001b[22m                                 \u001b[2mShow the total cost and duration of the current session\u001b[22m\r\n  \u001b[2m/pr-comments\u001b[22m                          \u001b[2mGet comments from a GitHub pull request\u001b[22m\r\n  \u001b[2m/mcp\u001b[22m                                  \u001b[2mManage MCP servers\u001b[22m\r\n  \u001b[2m/doctor\u001b[22m                               \u001b[2mDiagnose and verify your Claude Code installation and settings\u001b[22m\r\n  \u001b[2m/security-review\u001b[22m                      \u001b[2mComplete a security review of the pending changes on the current branch\u001b[22m\r\n  \u001b[2m/sentry:find_errors_in_file (MCP)\u001b[22m     \u001b[2mUse this prompt when you need to find errors in Sentry for a given file. \u001b[22m\r\n                                        \u001b[2m(arguments: organizationSlug, filename)\u001b[22m\r\n"]
