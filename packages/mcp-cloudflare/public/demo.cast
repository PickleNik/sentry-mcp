[383.18927, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\r\n\u001b[38;5;114m●\u001b[39m \u001b[1mUpdate\u001b[22m(packages/mcp-server/src/api-client/schema.ts)\r\n  ⎿  Updated \u001b[1mpackages/mcp-server/src/api-client/schema.ts\u001b[22m with \u001b[1m24\u001b[22m additions and \u001b[1m3\u001b[22m removals\u001b(B\r\n     \u001b[38;5;246m  614 \u001b[38;5;231m   );\u001b[39m\r\n     \u001b[38;5;246m  615 \u001b[38;5;231m   \u001b[39m\r\n     \u001b[38;5;246m  616 \u001b[38;5;231m   /**\u001b[39m\r\n     \u001b[38;5;246m  617 \u001b[48;5;65m\u001b[38;5;231m+   * Schema for issue objects that can appear in trace responses.\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  618 \u001b[48;5;65m\u001b[38;5;231m+   *\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  619 \u001b[48;5;65m\u001b[38;5;231m+   * When Sentry's trace API returns standalone errors, they are returned as\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  620 \u001b[48;5;65m\u001b[38;5;231m+   * SerializedIssue objects that lack the span-specific fields.\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  621 \u001b[48;5;65m\u001b[38;5;231m+   */\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  622 \u001b[48;5;65m\u001b[38;5;231m+  export const TraceIssueSchema = z.object({\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  623 \u001b[48;5;65m\u001b[38;5;231m+    id: z.union([z.string(), z.number()]).optional(),\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  624 \u001b[48;5;65m\u001b[38;5;231m+    issue_id: z.union([z.string(), z.number()]).optional(),\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  625 \u001b[48;5;65m\u001b[38;5;231m+    project_id: z.union([z.string(), z.number()]).optional(),\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  626 \u001b[48;5;65m\u001b[38;5;231m+    project_slug: z.string().optional(),\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  627 \u001b[48;5;65m\u001b[38;5;231m+    title: z.string().optional(),\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  628 \u001b[48;5;65m\u001b[38;5;231m+    culprit: z.string().optional(),\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  629 \u001b[48;5;65m\u001b[38;5;231m+    type: z.string().optional(),\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  630 \u001b[48;5;65m\u001b[38;5;231m+    timestamp: z.union([z.string(), z.number()]).optional(),\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  631 \u001b[48;5;65m\u001b[38;5;231m+  }).passthrough();\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  632 \u001b[48;5;65m\u001b[38;5;231m+  \u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  633 \u001b[48;5;65m\u001b[38;5;231m+  /**\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  634 \u001b[38;5;231m    * Schema for Sentry trace response.\u001b[39m\r\n     \u001b[38;5;246m  635 \u001b[38;5;231m    *\u001b[39m\r\n     \u001b[38;5;246m  636 \u001b[38;5;231m    * Contains the complete trace tree starting from root spans.\u001b[39m\r\n     \u001b[38;5;246m  637 \u001b[39m\u001b[48;5;95m-  \u001b[38;5;231m * The response is an array \u001b[48;5;174mof\u001b[48;5;95m root-level spans\u001b[48;5;174m, each potentially\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  638 \u001b[48;5;95m\u001b[38;5;231m-   * containing nested children spans.\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  637 \u001b[39m\u001b[48;5;65m+  \u001b[38;5;231m * The response is an array \u001b[48;5;72mthat\u001b[48;5;65m \u001b[48;5;72mcan contain both \u001b[48;5;65mroot-level spans\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  638 \u001b[48;5;65m\u001b[38;5;231m+   * and standalone issue objects. The Sentry API's query_trace_data\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  639 \u001b[48;5;65m\u001b[38;5;231m+   * function returns a mixed list of SerializedSpan and SerializedIssue\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  640 \u001b[48;5;65m\u001b[38;5;231m+   * objects when there are errors not directly associated with spans.\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  641 \u001b[38;5;231m    */\u001b[39m\r\n     \u001b[38;5;246m  642 \u001b[39m\u001b[48;5;95m-  \u001b[38;5;231mexport const TraceSchema = z.array(\u001b[48;5;174mTraceSpanSchema);\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  642 \u001b[39m\u001b[48;5;65m+  \u001b[38;5;231mexport const TraceSchema = z.array(\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  643 \u001b[48;5;65m\u001b[38;5;231m+    z.union([TraceSpanSchema, TraceIssueSchema])\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  644 \u001b[48;5;65m\u001b[38;5;231m+  );\u001b[39m\u001b[49m\r\n"]
