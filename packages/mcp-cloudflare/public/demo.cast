[454.974662, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\r\n\u001b[38;5;114m●\u001b[39m \u001b[1mUpdate\u001b[22m(packages/mcp-server/src/tools/get-trace-details.ts)\r\n  ⎿  Updated \u001b[1mpackages/mcp-server/src/tools/get-trace-details.ts\u001b[22m with \u001b[1m1\u001b[22m addition and \u001b[1m1\u001b[22m removal\u001b(B\r\n     \u001b[38;5;246m  219 \u001b[38;5;231m     }\u001b[39m\r\n     \u001b[38;5;246m  220 \u001b[38;5;231m   \u001b[39m\r\n     \u001b[38;5;246m  221 \u001b[38;5;231m     // Sort root spans by duration and select the most interesting ones\u001b[39m\r\n     \u001b[38;5;246m  222 \u001b[39m\u001b[48;5;95m-  \u001b[38;5;231m  const sortedRoots = \u001b[48;5;174mspans\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  222 \u001b[39m\u001b[48;5;65m+  \u001b[38;5;231m  const sortedRoots = \u001b[48;5;72mactualSpans\u001b[39m\u001b[49m\r\n     \u001b[38;5;246m  223 \u001b[38;5;231m       .sort((a, b) => (b.duration || 0) - (a.duration || 0))\u001b[39m\r\n     \u001b[38;5;246m  224 \u001b[38;5;231m       .slice(0, 5); // Start with top 5 root spans\u001b[39m\r\n     \u001b[38;5;246m  225 \u001b[38;5;231m   \u001b[39m\r\n"]
