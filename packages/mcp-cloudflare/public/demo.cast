[230.625269, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\r\n\u001b[38;5;246m> /mcp \u001b[39m\r\n\r\n\u001b[38;5;174m·\u001b[39m \u001b[38;5;174mGetting issue details from Sentry… \u001b[39m\u001b[2m(esc to interrupt · /todos)\u001b[22m\r\n  ⎿  \u001b[2mNext: Analyze the issue with Seer\u001b[22m\r\n\r\n\u001b[2m\u001b[38;5;244m╭──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m│\u001b[22m\u001b[38;5;246m > \u001b[39m\u001b[7m \u001b[27m                                                                                                                      \u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[39m\u001b[22m\r\n  \u001b[38;5;147m⏵⏵ accept edits on\u001b[38;5;246m\u001b[2m (shift+tab to cycle)\u001b[22m\u001b[39m                                             \u001b[38;5;211m2 MCP servers failed\u001b[39m \u001b[2m· /mcp for info\u001b[22m\r\n"]
