[214.617218, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\r\n\u001b[2m\u001b[38;5;244m╭──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m > /\u001b[7m \u001b[27m                                                                                                                     \u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[39m\u001b[22m\r\n  \u001b[38;5;153m/gh-pr\u001b[39m              \u001b[38;5;153mCreate (or update) a Pull Request. (project)\u001b[39m\r\n  \u001b[2m/gh-review\u001b[22m          \u001b[2mAddress feedback and checks in a Pull Request. (project)\u001b[22m\r\n  \u001b[2m/add-dir\u001b[22m            \u001b[2mAdd a new working directory\u001b[22m\r\n  \u001b[2m/agents\u001b[22m             \u001b[2mManage agent configurations\u001b[22m\r\n  \u001b[2m/bashes\u001b[22m             \u001b[2mList and manage background bash shells\u001b[22m\r\n  \u001b[2m/bug\u001b[22m                \u001b[2mSubmit feedback about Claude Code\u001b[22m\r\n  \u001b[2m/clear (reset)\u001b[22m      \u001b[2mClear conversation history and free up context\u001b[22m\r\n  \u001b[2m/compact\u001b[22m            \u001b[2mClear conversation history but keep a summary in context. Optional: /compact [instructions for \u001b[22m\r\n                      \u001b[2msummarization]\u001b[22m\r\n  \u001b[2m/config (theme)\u001b[22m     \u001b[2mOpen config panel\u001b[22m\r\n  \u001b[2m/context\u001b[22m            \u001b[2mVisualize current context usage as a colored grid\u001b[22m\r\n"]
[214.711282, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\r\n\u001b[2m\u001b[38;5;244m╭──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m > /m\u001b[7m \u001b[27m                                                                                                                    \u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[39m\u001b[22m\r\n  \u001b[38;5;153m/gh-pr\u001b[39m              \u001b[38;5;153mCreate (or update) a Pull Request. (project)\u001b[39m\r\n  \u001b[2m/gh-review\u001b[22m          \u001b[2mAddress feedback and checks in a Pull Request. (project)\u001b[22m\r\n  \u001b[2m/add-dir\u001b[22m            \u001b[2mAdd a new working directory\u001b[22m\r\n  \u001b[2m/agents\u001b[22m             \u001b[2mManage agent configurations\u001b[22m\r\n  \u001b[2m/bashes\u001b[22m             \u001b[2mList and manage background bash shells\u001b[22m\r\n  \u001b[2m/bug\u001b[22m                \u001b[2mSubmit feedback about Claude Code\u001b[22m\r\n  \u001b[2m/clear (reset)\u001b[22m      \u001b[2mClear conversation history and free up context\u001b[22m\r\n  \u001b[2m/compact\u001b[22m            \u001b[2mClear conversation history but keep a summary in context. Optional: /compact [instructions for \u001b[22m\r\n                      \u001b[2msummarization]\u001b[22m\r\n  \u001b[2m/config (theme)\u001b[22m     \u001b[2mOpen config panel\u001b[22m\r\n  \u001b[2m/context\u001b[22m            \u001b[2mVisualize current context usage as a colored grid\u001b[22m\r\n"]
[214.755826, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\r\n\u001b[2m\u001b[38;5;244m╭──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m > /m\u001b[7m \u001b[27m                                                                                                                    \u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[39m\u001b[22m\r\n  \u001b[38;5;153m/mcp\u001b[39m                                  \u001b[38;5;153mManage MCP servers\u001b[39m\r\n  \u001b[2m/memory\u001b[22m                               \u001b[2mEdit Claude memory files\u001b[22m\r\n  \u001b[2m/model\u001b[22m                                \u001b[2mSet the AI model for Claude Code\u001b[22m\r\n  \u001b[2m/compact\u001b[22m                              \u001b[2mClear conversation history but keep a summary in context. Optional: /compact \u001b[22m\r\n                                        \u001b[2m[instructions for summarization]\u001b[22m\r\n  \u001b[2m/pr-comments\u001b[22m                          \u001b[2mGet comments from a GitHub pull request\u001b[22m\r\n  \u001b[2m/vim\u001b[22m                                  \u001b[2mToggle between Vim and Normal editing modes\u001b[22m\r\n  \u001b[2m/config (theme)\u001b[22m                       \u001b[2mOpen config panel\u001b[22m\r\n  \u001b[2m/permissions (allowed-tools)\u001b[22m          \u001b[2mManage allow & deny tool permission rules\u001b[22m\r\n  \u001b[2m/resume\u001b[22m                               \u001b[2mResume a conversation\u001b[22m\r\n  \u001b[2m/sentry:find_errors_in_file (MCP)\u001b[22m     \u001b[2mUse this prompt when you need to find errors in Sentry for a given file. \u001b[22m\r\n                                        \u001b[2m(arguments: organizationSlug, filename)\u001b[22m\r\n"]
[214.803194, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\r\n\u001b[2m\u001b[38;5;244m╭──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m > /mc\u001b[7m \u001b[27m                                                                                                                   \u001b[2m\u001b[38;5;244m│\u001b[39m\u001b[22m\r\n\u001b[2m\u001b[38;5;244m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[39m\u001b[22m\r\n  \u001b[38;5;153m/mcp\u001b[39m                                  \u001b[38;5;153mManage MCP servers\u001b[39m\r\n  \u001b[2m/memory\u001b[22m                               \u001b[2mEdit Claude memory files\u001b[22m\r\n  \u001b[2m/model\u001b[22m                                \u001b[2mSet the AI model for Claude Code\u001b[22m\r\n  \u001b[2m/compact\u001b[22m                              \u001b[2mClear conversation history but keep a summary in context. Optional: /compact \u001b[22m\r\n                                        \u001b[2m[instructions for summarization]\u001b[22m\r\n  \u001b[2m/pr-comments\u001b[22m                          \u001b[2mGet comments from a GitHub pull request\u001b[22m\r\n  \u001b[2m/vim\u001b[22m                                  \u001b[2mToggle between Vim and Normal editing modes\u001b[22m\r\n  \u001b[2m/config (theme)\u001b[22m                       \u001b[2mOpen config panel\u001b[22m\r\n  \u001b[2m/permissions (allowed-tools)\u001b[22m          \u001b[2mManage allow & deny tool permission rules\u001b[22m\r\n  \u001b[2m/resume\u001b[22m                               \u001b[2mResume a conversation\u001b[22m\r\n  \u001b[2m/sentry:find_errors_in_file (MCP)\u001b[22m     \u001b[2mUse this prompt when you need to find errors in Sentry for a given file. \u001b[22m\r\n                                        \u001b[2m(arguments: organizationSlug, filename)\u001b[22m\r\n"]
